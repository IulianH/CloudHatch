{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to NodeAuth (Docker)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "localRoot": "${workspaceFolder}/NodeAuth",
      "remoteRoot": "/app",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }, 
    {
      "name": "Attach to NodeBackApi (Docker)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "address": "localhost",
      "restart": true,
      "localRoot": "${workspaceFolder}/NodeBackApi",
      "remoteRoot": "/app",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
